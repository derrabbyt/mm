# Copy to .env. Every value is required except LOG_LEVEL
LOG_LEVEL=DEBUG

REDIS_HOST=localhost
REDIS_DB=0
REDIS_PORT=6379
REDIS_PASSWORD=mm

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mm
POSTGRES_USER=mm
POSTGRES_PASSWORD=mm

PHOTON_PORT=2322
# Where the prebuilt Photon index lives. Defaults to ./data/photon; point it
# elsewhere to share one 1.3 GB index between projects.
# PHOTON_DATA_DIR=

FRONTEND_URL=http://localhost:4200
# Derived from the values above. Uncomment for override.
# DATABASE_URL=
# REDIS_URL=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
