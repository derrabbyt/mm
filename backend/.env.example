# Copy to .env. Every value is required except LOG_LEVEL
LOG_LEVEL=DEBUG

REDIS_HOST=localhost
REDIS_DB=0
REDIS_PORT=6379
REDIS_PASSWORD=mm

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mm
POSTGRES_USER=mm
POSTGRES_PASSWORD=mm

PHOTON_PORT=2322
# Where the prebuilt Photon index lives. Defaults to ./data/photon; point it
# elsewhere to share one 1.3 GB index between projects.
# PHOTON_DATA_DIR=

FRONTEND_URL=http://localhost:4200
# Derived from the values above. Uncomment for override.
# DATABASE_URL=
# REDIS_URL=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The most of one Source's live Listings a single run may retire. Above this
# share the run logs and retires nothing for that Source, on the grounds that a
# site does not lose most of its programme between two runs and a markup change
# looks exactly like one that did.
# SCRAPE_MAX_RETIRED_SHARE=0.6

# The scraping job connects as its own database role, which owns the `content`
# schema and has no grant on the application's tables - so a bug in scraping
# cannot reach an account or a meetup. The role and its grants are created by a
# migration; this is the credential it logs in with, and the value below is a
# local-development one like POSTGRES_PASSWORD above. Unset, the job connects as
# the application instead and says so at WARNING on every run.
#
# The migration sets this password only when it creates the role, so rotating it
# afterwards is `ALTER ROLE mm_scraper PASSWORD ...` plus this variable, and
# re-running migrations will not undo it.
SCRAPER_POSTGRES_PASSWORD=mm_scraper
# SCRAPER_POSTGRES_USER=mm_scraper
# SCRAPER_DATABASE_URL=

# Where fetched payloads are archived, and how many days are kept. Evidence for
# fixing a parser against the document that broke it - replay one with
# `python -m app.modules.events.replay <source>`. Payloads are stored under a
# digest of themselves, so an hourly run only costs disk for pages that actually
# changed; the scrape expires older days itself at the start of each run.
# SCRAPE_ARCHIVE_DIR=data/archive
# SCRAPE_ARCHIVE_RETENTION_DAYS=14

# The geocoder. Points at the Photon that docker compose runs; there is no
# public default, so a misconfiguration fails loudly instead of quietly sending
# every scraped address to somebody else's service.
# GEOCODER_URL=http://127.0.0.1:2322/api
# GEOCODER_ENABLED=true
